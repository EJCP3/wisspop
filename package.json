{
  "name": "wisspop-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "dev:test": "pnpm --filter docs-test dev",
    "dev:vue": "pnpm --filter vue-docs dev",
    "dev:react": "pnpm --filter react-docs dev",
    "dev:astro": "pnpm --filter docs-astro dev",
    "build": "pnpm --filter wisspop build && pnpm --filter docs build",
    "test": "pnpm --filter wisspop test"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
