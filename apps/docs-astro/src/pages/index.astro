---
import { WissPopMorph, WissPopPill, WissPopFlip } from "wisspop/astro";
import "wisspop/styles.css";
import "../styles/docs.css";

const ANCLADOS = [
  { placement: "top", align: "start", etiqueta: "↑ inicio" },
  { placement: "top", align: "center", etiqueta: "↑ centro" },
  { placement: "top", align: "end", etiqueta: "↑ final" },
  { placement: "left", align: "center", etiqueta: "← izquierda" },
  { placement: "right", align: "center", etiqueta: "derecha →" },
  { placement: "bottom", align: "center", etiqueta: "↓ abajo" },
];

const DRAWERS = ["left", "right", "top", "bottom"];

const EASES = [
  {
    ease: "back.out(1.7)",
    label: "(Rebote)",
    desc: "Rebote con overshoot elástico al expandirse.",
    closeEase: "power3.in",
    dur: 0.65,
    closeDur: 0.35,
  },
  {
    ease: "power3.out",
    label: "(Suave)",
    desc: "Desaceleración suave, profesional y fluida.",
    closeEase: "power2.in",
    dur: 0.5,
    closeDur: 0.3,
  },
  {
    ease: "elastic.out(1, 0.75)",
    label: "(Resorte)",
    desc: "Efecto resorte gomoso pronunciado.",
    closeEase: "power2.inOut",
    dur: 0.85,
    closeDur: 0.4,
  },
  {
    ease: "expo.out",
    label: "(Snap rápido)",
    desc: "Aceleración inicial instantánea con frenada suave.",
    closeEase: "expo.in",
    dur: 0.55,
    closeDur: 0.3,
  },
];

const ANIM_TYPES = ["slide-up", "slide-down", "scale", "fade", "none"];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WissPop — Astro Docs</title>
  </head>
  <body>
    <main class="page">
      <header>
        <h1>WissPop — Astro Docs</h1>
        <p class="lead">
          El panel no aparece de la nada: nace del elemento que lo abrió y
          vuelve a él al cerrarse.
        </p>
        <p class="note">
          Esta página está construida con componentes nativos de Astro (<code
            >wisspop/astro</code
          >):
          <code>WissPopMorph</code>, <code>WissPopPill</code> y <code
            >WissPopFlip</code
          >.
        </p>
      </header>

      <!-- 1 · Anclado a un botón -->
      <section>
        <h2>Anclado a un botón</h2>
        <p class="hint">
          El panel nace del botón y se abre hacia el lado que le pidas. <code
            >align</code
          > es la posición sobre el <strong>eje cruzado</strong>: con el panel
          arriba o abajo alinea en horizontal, y al costado alinea en vertical.
        </p>
        <div class="matriz">
          {
            ANCLADOS.map((item) => (
              <button
                data-wisspop-trigger={`anclado-${item.placement}-${item.align}`}
              >
                {item.etiqueta}
              </button>
            ))
          }
        </div>

        {
          ANCLADOS.map((item) => (
            <WissPopMorph
              id={`anclado-${item.placement}-${item.align}`}
              placement={item.placement}
              align={item.align}
              modalClass="panel"
              swipeToClose={true}
            >
              <ul class="menu">
                <li data-wisspop-close>Más recientes</li>
                <li data-wisspop-close>Más antiguos</li>
                <li data-wisspop-close>Mayor monto</li>
              </ul>
            </WissPopMorph>
          ))
        }
      </section>

      <!-- 2 · Desde un botón circular -->
      <section>
        <h2>Desde un botón circular</h2>
        <p class="hint">
          El radio del origen se lee del CSS y se acota a la mitad del lado
          menor, así que un círculo se abre como círculo. <code
            >ease: "power3.out"</code
          >.
        </p>
        <div class="row">
          <button data-wisspop-trigger="fab-demo" class="round">+</button>
        </div>

        <WissPopMorph
          id="fab-demo"
          placement="center"
          ease="power3.out"
          duration={0.65}
          modalClass="panel"
          swipeToClose={true}
        >
          <div class="panel-body" style="width: 22rem;">
            <h3><span data-wisspop-title>+</span> Nuevo movimiento</h3>
            <label>Concepto</label>
            <input placeholder="Café" />
            <label>Monto</label>
            <input placeholder="2500" />
            <button data-wisspop-close>Guardar</button>
          </div>
        </WissPopMorph>
      </section>

      <!-- 3 · Crecer en el lugar -->
      <section>
        <h2>Crecer en el lugar</h2>
        <p class="hint">
          <code>placement: "origin"</code> — el panel comparte el centro con el botón
          y crece ahí mismo.
        </p>
        <div class="row">
          <button data-wisspop-trigger="inline-demo">Renombrar</button>
        </div>

        <WissPopMorph
          id="inline-demo"
          placement="origin"
          modalClass="panel"
          closeButton={true}
          swipeToClose={true}
        >
          <div class="panel-body" style="width: 20rem;">
            <h3>Renombrar</h3>
            <label>Nombre</label>
            <input placeholder="Supermercado" />
            <button data-wisspop-close>Listo</button>
          </div>
        </WissPopMorph>
      </section>

      <!-- 4 · Drawer -->
      <section>
        <h2>Drawer</h2>
        <p class="hint">
          <code>drawer-left</code> · <code>drawer-right</code> · <code
            >drawer-top</code
          > · <code>drawer-bottom</code>.
        </p>
        <div class="row">
          {
            DRAWERS.map((lado) => (
              <button data-wisspop-trigger={`drawer-${lado}-demo`}>
                drawer-{lado}
              </button>
            ))
          }
        </div>

        {
          DRAWERS.map((lado) => (
            <WissPopMorph
              id={`drawer-${lado}-demo`}
              placement={`drawer-${lado}`}
              modalClass={`panel drawer drawer-${lado}`}
              swipeToClose={true}
            >
              <ul class="menu">
                <li data-wisspop-close>Inicio</li>
                <li data-wisspop-close>Movimientos</li>
                <li data-wisspop-close>Presupuestos</li>
                <li data-wisspop-close>Ajustes</li>
              </ul>
            </WissPopMorph>
          ))
        }
      </section>

      <!-- 5 · Texto viajero -->
      <section>
        <h2>Texto viajero</h2>
        <p class="hint">
          El label del botón sale a 14px, viaja por la pantalla creciendo, y
          aterriza justo encima de <code>data-wisspop-title</code>.
        </p>
        <div class="row">
          <h3>Modal center</h3>
          <button data-wisspop-trigger="auth-center-demo" class="pill"
            >Crear cuenta</button
          >
          <h3>Modal origin</h3>
          <button data-wisspop-trigger="auth-origin-demo" class="pill"
            >Crear cuenta</button
          >
        </div>

        <WissPopPill
          id="auth-center-demo"
          placement="center"
          width={540}
          radius={40}
          modalClass="pill-panel"
          flyingTextClass="flying"
          swipeToClose={true}
        >
          <div class="pill-body">
            <h2 data-wisspop-title>Crear cuenta</h2>
            <label>Email</label>
            <input placeholder="hola@ejemplo.com" />
            <label>Contraseña</label>
            <input type="password" placeholder="••••••••" />
            <button
              data-wisspop-close
              class="pill"
              style="width: 100%; margin-top: 0.5rem;">Continuar</button
            >
          </div>
        </WissPopPill>

        <WissPopPill
          id="auth-origin-demo"
          placement="origin"
          width={540}
          radius={40}
          modalClass="pill-panel"
          flyingTextClass="flying"
          swipeToClose={true}
        >
          <div class="pill-body">
            <h2 data-wisspop-title>Crear cuenta</h2>
            <label>Email</label>
            <input placeholder="hola@ejemplo.com" />
            <label>Contraseña</label>
            <input type="password" placeholder="••••••••" />
            <button
              data-wisspop-close
              class="pill"
              style="width: 100%; margin-top: 0.5rem;">Continuar</button
            >
          </div>
        </WissPopPill>
      </section>

      <!-- 6 · Formatos del elemento viajero -->
      <section>
        <h2>Formatos del elemento viajero</h2>
        <p class="hint">
          Lo que viaja puede ser texto, un nodo, o las dos cosas.
        </p>
        <div class="row">
          <button data-wisspop-trigger="fmt-texto-demo" class="pill"
            >Solo texto</button
          >
          <button data-wisspop-trigger="fmt-mixto-demo" class="pill">
            <span class="con-icono">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"
                ></path>
              </svg>
              <span>Me gusta</span>
            </span>
          </button>
          <button data-wisspop-trigger="fmt-icono-demo" class="round">
            <svg
              class="ico"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245"
              ></path>
            </svg>
          </button>
          <button data-wisspop-trigger="fmt-imagen-demo" class="avatar-btn">
            <img src="/gato.jpg" alt="" />
          </button>
        </div>

        <WissPopMorph
          id="fmt-texto-demo"
          placement="center"
          flyingTextClass="flying"
          swipeToClose={true}
          modalClass="panel"
        >
          <div class="panel-body" style="width: 21rem;">
            <h3><span data-wisspop-title>Solo texto</span></h3>
            <p class="nota">
              No hay nodo que medir, así que el punto de partida sale del texto
              del botón.
            </p>
            <button data-wisspop-close>Cerrar</button>
          </div>
        </WissPopMorph>

        <WissPopMorph
          id="fmt-mixto-demo"
          placement="center"
          flyingTextClass="flying"
          swipeToClose={true}
          modalClass="panel"
        >
          <div class="panel-body" style="width: 21rem;">
            <h3>
              <span data-wisspop-title class="con-icono">
                <svg
                  class="ico"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"
                  ></path></svg
                >
                <span>Me gusta</span>
              </span>
            </h3>
            <p class="nota">
              El icono va en <code>em</code>: crece junto con el texto sin
              ninguna cuenta aparte.
            </p>
            <button data-wisspop-close>Cerrar</button>
          </div>
        </WissPopMorph>

        <WissPopMorph
          id="fmt-icono-demo"
          placement="center"
          flyingTextClass="flying"
          swipeToClose={true}
          modalClass="panel"
        >
          <div class="panel-body" style="width: 21rem;">
            <h3>
              <span data-wisspop-title class="ico-destino">
                <svg
                  class="ico"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245"
                  ></path></svg
                >
              </span>
            </h3>
            <p class="nota">
              Sin texto que escalar, el core pasa a <code>box</code>: anima <code
                >width</code
              >/<code>height</code>.
            </p>
            <button data-wisspop-close>Cerrar</button>
          </div>
        </WissPopMorph>

        <WissPopMorph
          id="fmt-imagen-demo"
          placement="center"
          flyingTextClass="flying"
          swipeToClose={true}
          modalClass="panel"
        >
          <div class="panel-body" style="width: 21rem;">
            <span data-wisspop-title class="foto-destino"
              ><img src="/gato.jpg" alt="" /></span
            >
            <h3 style="margin-top: 1rem;">No hace nada, HD</h3>
            <p class="nota">
              Despega desde el rect medido de la miniatura y aterriza en el
              destino.
            </p>
            <button data-wisspop-close>Cerrar</button>
          </div>
        </WissPopMorph>
      </section>

      <!-- 7 · Casos de uso avanzados con elemento viajero -->
      <section>
        <h2>Casos de uso avanzados con elemento viajero</h2>
        <p class="hint">
          El elemento viajero convierte acciones comunes en experiencias
          conectadas y fluidas.
        </p>

        <div class="row">
          <!-- 1. Checkout Pro -->
          <button data-wisspop-trigger="demo-checkout-modal" class="pill">
            <span class="con-icono">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path
                  d="M6 2l.01.002L6 2a2 2 0 0 1 2 2v2h8V4a2 2 0 0 1 2-2h.01M3 6h18a1 1 0 0 1 1 1v12a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V7a1 1 0 0 1 1-1zm6 4v2a3 3 0 0 0 6 0v-2"
                ></path></svg
              >
              <span>Plan Pro — $29/mes</span>
            </span>
          </button>

          <!-- 2. Invitar colaboradores -->
          <button data-wisspop-trigger="demo-invite-modal" class="pill">
            <span class="con-icono">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path
                  d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2M16 3.13a4 4 0 0 1 0 7.75M21 21v-2a4 4 0 0 0 -3 -3.85"
                ></path></svg
              >
              <span>Invitar colaboradores</span>
            </span>
          </button>

          <!-- 3. Barra de Filtros y Búsqueda -->
          <div class="search-filter-pill">
            <div class="search-filter-input-wrap con-icono">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path
                  d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0M21 21l-6 -6"
                ></path></svg
              >
              <input
                type="text"
                placeholder="Buscar comercio..."
                class="search-filter-input"
                autocomplete="off"
              />
            </div>
            <div class="search-filter-divider"></div>
            <button
              type="button"
              class="search-filter-btn"
              data-wisspop-trigger="demo-search-modal"
              data-wisspop-origin="closest:.search-filter-pill"
              data-wisspop-label="closest:.search-filter-pill .search-filter-input-wrap"
            >
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M4 6h16M4 12h16M4 18h16M8 4v4M16 10v4M10 16v4"
                ></path></svg
              >
              <span>Filtros</span>
            </button>
          </div>

          <!-- 4. Confirmación destructiva -->
          <button data-wisspop-trigger="demo-delete-modal" class="btn-danger">
            <span class="con-icono">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path
                  d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12M9 7V4a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"
                ></path></svg
              >
              <span>Eliminar Proyecto</span>
            </span>
          </button>
        </div>

        <!-- Modal 1: Checkout -->
        <WissPopMorph
          id="demo-checkout-modal"
          placement="center"
          flyingTextClass="flying"
          contentStagger={true}
          contentAnimation="slide-up"
          ease="power3.out"
          duration={0.6}
          closeButton={true}
          swipeToClose={true}
          modalClass="panel"
        >
          <div class="panel-body" style="width: 25rem">
            <h3
              class="con-icono"
              data-wisspop-title
              style="margin-bottom: 0.25rem;"
            >
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M6 2l.01.002L6 2a2 2 0 0 1 2 2v2h8V4a2 2 0 0 1 2-2h.01M3 6h18a1 1 0 0 1 1 1v12a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V7a1 1 0 0 1 1-1zm6 4v2a3 3 0 0 0 6 0v-2"
                ></path></svg
              >
              <span>Plan Pro — $29/mes</span>
            </h3>
            <p class="nota" style="margin-bottom: 0.75rem;">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path
                  d="M12 9h.01"></path><path d="M11 12h1v4h1"></path></svg
              >
              <span
                >Acceso ilimitado a todas las herramientas de animación.</span
              >
            </p>

            <label>Método de pago preferido</label>
            <div class="payment-options">
              <div class="payment-card">Tarjeta Crédito</div>
              <div class="payment-card">Apple Pay</div>
              <div class="payment-card">PayPal</div>
              <div class="payment-card">Google Pay</div>
            </div>

            <label>Correo de facturación</label>
            <input type="email" value="alex@acme-design.studio" />

            <button
              style="width: 100%; background: var(--accent); color: #fff; font-weight: 700; padding: 0.75rem; border: none; border-radius: 10px; margin-top: 0.5rem;"
              data-wisspop-close
            >
              Confirmar Suscripción ($29)
            </button>
          </div>
        </WissPopMorph>

        <!-- Modal 2: Invitar -->
        <WissPopMorph
          id="demo-invite-modal"
          placement="center"
          flyingTextClass="flying"
          contentAnimation="scale"
          ease="back.out(1.5)"
          duration={0.55}
          closeButton={true}
          swipeToClose={true}
          modalClass="panel"
        >
          <div class="panel-body" style="width: 23rem">
            <h3 class="con-icono" data-wisspop-title>
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2M16 3.13a4 4 0 0 1 0 7.75M21 21v-2a4 4 0 0 0 -3 -3.85"
                ></path></svg
              >
              <span>Invitar colaboradores</span>
            </h3>
            <p class="nota">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path
                  d="M12 9h.01"></path><path d="M11 12h1v4h1"></path></svg
              >
              <span>Comparte acceso a tus componentes con tu equipo.</span>
            </p>

            <label>Correo electrónico</label>
            <input type="email" placeholder="companero@empresa.com" />

            <label>Rol asignado</label>
            <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem;">
              <button
                style="flex: 1; padding: 0.4rem; font-size: 0.85rem; border-color: var(--accent); color: var(--accent);"
                >Editor</button
              >
              <button style="flex: 1; padding: 0.4rem; font-size: 0.85rem;"
                >Admin</button
              >
              <button style="flex: 1; padding: 0.4rem; font-size: 0.85rem;"
                >Lector</button
              >
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
              <button data-wisspop-close>Cancelar</button>
              <button
                style="background: var(--accent); color: #fff; font-weight: 600;"
                data-wisspop-close>Enviar invitación</button
              >
            </div>
          </div>
        </WissPopMorph>

        <!-- Modal 3: Filtros -->
        <WissPopMorph
          id="demo-search-modal"
          placement="center"
          flyingTextClass="flying"
          contentAnimation="slide-down"
          swipeToClose={true}
          modalClass="panel filter-modal-panel"
        >
          <div class="filter-modal-header">
            <div class="filter-modal-search-wrap con-icono" data-wisspop-title>
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0M21 21l-6 -6"
                ></path></svg
              >
              <input
                type="text"
                class="filter-modal-input"
                placeholder="Buscar comercio..."
                autofocus
              />
            </div>
            <button
              type="button"
              class="filter-close-btn"
              aria-label="Cerrar"
              data-wisspop-close
            >
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                ><path d="M18 6 6 18M6 6l12 12"></path></svg
              >
            </button>
          </div>

          <div class="filter-col" style="gap: 1.15rem;">
            <div class="filter-group">
              <label class="filter-label">RANGO DE FECHA</label>
              <button type="button" class="filter-select-btn">
                <span>Cualquier Fecha</span>
                <svg
                  class="ico chevron"
                  viewBox="0 0 24 24"
                  stroke-width="2"
