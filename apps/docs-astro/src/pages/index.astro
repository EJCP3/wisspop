        up: {
          origin: "bottom center",
          pos: (b, row) => ({
            bottom: `${row.offsetHeight - b.offsetTop + GAP}px`,
            left: `${b.offsetLeft}px`,
          }),
        },
        right: {
          origin: "left center",
          pos: (b) => ({
            top: `${b.offsetTop}px`,
            left: `${b.offsetLeft + b.offsetWidth + GAP}px`,
          }),
        },
        left: {
          origin: "right center",
          pos: (b, row) => ({
            top: `${b.offsetTop}px`,
            right: `${row.offsetWidth - b.offsetLeft + GAP}px`,
          }),
        },
      };

      const row = document.getElementById("dropdown-row");
      const panel = document.getElementById("dropdown-panel");
      let dropdownDir = null;

      function closeDropdown() {
        if (!panel || !dropdownDir) return;
        const { origin } = DROPDOWN_DIRS[dropdownDir];
        dropdownDir = null;
        leaveDropdownAnimation(panel, () => (panel.style.display = "none"), {
          transformOrigin: origin,
        });
      }

      function openDropdown(dir, btn) {
        if (!panel || !row || !btn) return;
        dropdownDir = dir;
        const { origin, pos } = DROPDOWN_DIRS[dir];
        Object.assign(panel.style, {
          top: "",
          bottom: "",
          left: "",
          right: "",
          ...pos(btn, row),
          display: "block",
        });
        enterDropdownAnimation(panel, null, { transformOrigin: origin });
      }

      if (row && panel) {
        panel
          .querySelectorAll("li")
          .forEach((li) => li.addEventListener("click", closeDropdown));
        row.querySelectorAll("[data-dir]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const dir = btn.dataset.dir;
            if (dropdownDir === dir) closeDropdown();
            else openDropdown(dir, btn);
          });
        });
        document.addEventListener("click", (e) => {
          if (!dropdownDir || panel.contains(e.target)) return;
          if (e.target.closest("[data-dir]")) return;
          closeDropdown();
        });
      }
    </script>
  </body>
</html>
