---
import CodeBlock from './CodeBlock.astro';

interface Props {
  title?: string;
  description?: string;
  code: string;
  lang?: string;
}

const { title, description, code, lang = 'javascript' } = Astro.props;
---

<div class="doc-example-card my-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 overflow-hidden shadow-sm">
  {title && (
    <div class="px-6 pt-6 pb-2">
      <h3 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{title}</h3>
      {description && <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 leading-relaxed">{description}</p>}
    </div>
  )}

  <div class="tab-wrapper">
    <div class="flex items-center gap-6 px-6 border-b border-zinc-200 dark:border-zinc-800 text-sm font-medium bg-zinc-50/50 dark:bg-zinc-900/50">
      <button type="button" class="tab-btn btn-preview active py-3 text-zinc-900 dark:text-zinc-100 border-b-2 border-zinc-900 dark:border-zinc-100 cursor-pointer font-semibold transition-colors">
        Preview
      </button>
      <button type="button" class="tab-btn btn-code py-3 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 border-b-2 border-transparent cursor-pointer transition-colors">
        Code
      </button>
    </div>

    <div class="tab-content-preview p-6 flex flex-col justify-center items-center min-h-[160px] bg-white dark:bg-zinc-950">
      <slot />
    </div>

    <div class="tab-content-code hidden p-4 bg-zinc-50 dark:bg-zinc-900/80">
      <CodeBlock code={code} lang={lang} />
    </div>
  </div>
</div>

<script>
  function setupExampleCards() {
    document.querySelectorAll('.doc-example-card').forEach((card) => {
      const btnPreview = card.querySelector('.btn-preview');
      const btnCode = card.querySelector('.btn-code');
      const contentPreview = card.querySelector('.tab-content-preview');
      const contentCode = card.querySelector('.tab-content-code');

      if (!btnPreview || !btnCode || !contentPreview || !contentCode) return;

      btnPreview.addEventListener('click', () => {
        btnPreview.classList.add('text-zinc-900', 'dark:text-zinc-100', 'border-zinc-900', 'dark:border-zinc-100', 'font-semibold');
        btnPreview.classList.remove('text-zinc-400', 'border-transparent');

        btnCode.classList.remove('text-zinc-900', 'dark:text-zinc-100', 'border-zinc-900', 'dark:border-zinc-100', 'font-semibold');
        btnCode.classList.add('text-zinc-400', 'border-transparent');

        contentPreview.classList.remove('hidden');
        contentCode.classList.add('hidden');
      });

      btnCode.addEventListener('click', () => {
        btnCode.classList.add('text-zinc-900', 'dark:text-zinc-100', 'border-zinc-900', 'dark:border-zinc-100', 'font-semibold');
        btnCode.classList.remove('text-zinc-400', 'border-transparent');

        btnPreview.classList.remove('text-zinc-900', 'dark:text-zinc-100', 'border-zinc-900', 'dark:border-zinc-100', 'font-semibold');
        btnPreview.classList.add('text-zinc-400', 'border-transparent');

        contentCode.classList.remove('hidden');
        contentPreview.classList.add('hidden');
      });
    });
  }

  setupExampleCards();
  document.addEventListener('astro:after-swap', setupExampleCards);
</script>
