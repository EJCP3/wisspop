---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: string;
  variant?: "default" | "error" | "success";
  label?: string;
}

const { code, lang = "bash", variant = "default", label } = Astro.props;

// Map custom langs if needed
const shikiLang =
  lang === "vue" ||
  lang === "astro" ||
  lang === "javascript" ||
  lang === "typescript" ||
  lang === "html" ||
  lang === "css" ||
  lang === "bash" ||
  lang === "json"
    ? lang
    : "javascript";

// Clases según variante
const wrapperClasses = {
  default:
    "border-zinc-200 dark:border-zinc-800 bg-zinc-950 text-zinc-100 shadow-sm",
  error:
    "border-rose-200 dark:border-rose-900/80 bg-[#16080d] text-rose-100 shadow-sm shadow-rose-100 dark:shadow-none",
  success:
    "border-emerald-200 dark:border-emerald-900/80 bg-[#071710] text-emerald-100 shadow-sm shadow-emerald-100 dark:shadow-none",
}[variant];

const headerClasses = {
  default: "bg-zinc-900/90 border-zinc-800 text-zinc-400",
  error: "bg-rose-950/80 border-rose-900/80 text-rose-300 font-medium",
  success:
    "bg-emerald-950/80 border-emerald-900/80 text-emerald-300 font-medium",
}[variant];
---

<div
  class={`relative group my-4 rounded-xl border overflow-hidden font-mono text-xs ${wrapperClasses}`}
>
  <div
    class={`flex items-center justify-between px-4 py-2 border-b text-xs ${headerClasses}`}
  >
    <div class="flex items-center gap-2">
      <span class="font-semibold">{label || lang}</span>
      {label && <span class="text-[10px] opacity-70">({lang})</span>}
    </div>
    <button
      class="copy-code-btn hover:opacity-100 opacity-70 transition-opacity flex items-center gap-1"
    >
      <span>Copy</span>
    </button>
  </div>
  <div
    class="p-4 overflow-x-auto text-[13px] leading-relaxed [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!overflow-visible"
  >
    <Code code={code.trim()} lang={shikiLang as any} theme="github-dark" />
  </div>
</div>

<script>
  function setupCodeBlockCopy() {
    document.querySelectorAll(".copy-code-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pre = btn.closest(".group")?.querySelector("pre");
        if (pre) {
          navigator.clipboard.writeText(pre.innerText);
          const span = btn.querySelector("span");
          if (span) {
            span.textContent = "Copied!";
            setTimeout(() => (span.textContent = "Copy"), 1500);
          }
        }
      });
    });
  }
  setupCodeBlockCopy();
  document.addEventListener("astro:after-swap", setupCodeBlockCopy);
</script>

