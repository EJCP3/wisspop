---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
}

const { code, lang = 'bash' } = Astro.props;
---

<div class="doc-codeblock bg-[#f2f5f9] dark:bg-[#1a1a1e] p-4 sm:p-6 rounded-2xl border border-[#e2e8f0] dark:border-zinc-800 relative group my-4">
  <button
    type="button"
    class="copy-code-btn absolute top-4 right-4 bg-white/80 hover:bg-white dark:bg-zinc-800/80 dark:hover:bg-zinc-800 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 rounded-lg p-2 opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity border border-zinc-200/50 dark:border-zinc-700 shadow-sm z-10"
    aria-label="Copiar código"
  >
    <svg class="icon-copy w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <svg class="icon-check w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  </button>

  <div class="overflow-x-auto text-[13px] leading-loose font-mono relative">
    <Code
      code={code.trim()}
      lang={lang}
      themes={{ light: 'vitesse-light', dark: 'vitesse-dark' }}
      defaultColor={false}
      contenteditable="true"
      spellcheck="false"
      class="doc-code !bg-transparent outline-none"
    />
  </div>

  <button
    type="button"
    class="run-code-btn absolute bottom-4 right-4 flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-xs font-semibold shadow-lg opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity z-10"
  >
    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
    RUN
  </button>
</div>

<style is:global>
  /* Un solo <pre> con las dos paletas en CSS vars, en vez de los dos <pre>
     (`dark:hidden` / `hidden dark:block`) que usa la referencia: con dos
     copias, editar una no se refleja en la otra y `contenteditable` deja de
     tener sentido. */
  .doc-code,
  .doc-code span {
    color: var(--shiki-light);
  }
  html.dark .doc-code,
  html.dark .doc-code span {
    color: var(--shiki-dark);
  }
</style>

<script>
  /**
   * RUN no reejecuta el texto editado — eso necesita un sandbox (eval con
   * scope propio) que no vale la pena para un botón de demo. Dispara el
   * primer trigger real del Preview de la misma tarjeta: el mismo código que
   * se ve, ya viviendo en la página.
   */
  function setupCodeBlocks() {
    document.querySelectorAll('.doc-codeblock').forEach((block) => {
      const copyBtn = block.querySelector('.copy-code-btn');
      const runBtn = block.querySelector('.run-code-btn');
      const code = block.querySelector('.doc-code');
      const card = block.closest('.doc-example-card');

      copyBtn?.addEventListener('click', () => {
        if (!code) return;
        navigator.clipboard.writeText(code.textContent || '');
        const copyIcon = copyBtn.querySelector('.icon-copy');
        const checkIcon = copyBtn.querySelector('.icon-check');
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
        }, 1500);
      });

      // Sin tarjeta no hay demo que correr — snippets sueltos (instalación,
      // uso de otro framework) no llevan RUN.
      if (!card) {
        runBtn?.remove();
      } else {
        runBtn?.addEventListener('click', () => {
          card.querySelector('.btn-preview')?.click();
          card.querySelector('.tab-content-preview button, .tab-content-preview [data-wisspop-trigger]')?.click();
        });
      }
    });
  }
  setupCodeBlocks();
  document.addEventListener('astro:after-swap', setupCodeBlocks);
</script>
