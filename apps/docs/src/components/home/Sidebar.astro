---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Un solo listado en vez de doce `<a>` copiados: el orden acá es el orden
 * real de la página, así que un anchor que se mueve se arregla en un renglón.
 * `sub: true` son las tarjetas de ejemplo dentro de "Uso Básico".
 */
const INDICE = [
  { href: '#introduccion', label: t('sidebar.introduccion') },
  { href: '#instalacion', label: t('sidebar.instalacion') },
  { href: '#frameworks', label: t('sidebar.frameworks') },
  { href: '#uso-basico', label: t('sidebar.uso_basico') },
  { href: '#morph-modal', label: t('sidebar.morph_modal'), sub: true },
  { href: '#pill-modal', label: t('sidebar.pill_modal'), sub: true },
  { href: '#flip-modal', label: t('sidebar.flip_modal'), sub: true },
  { href: '#dropdown-panel', label: t('sidebar.dropdown_panel'), sub: true },
  { href: '#metodos', label: t('sidebar.metodos') },
  { href: '#opciones', label: t('sidebar.opciones') },
  { href: '#css', label: t('sidebar.css') },
  { href: '#accesibilidad', label: t('sidebar.accesibilidad') },
];
---

<!-- Sticky Sidebar -->
<aside class="w-48 shrink-0 hidden md:block">
  <div class="sticky top-24 space-y-6">
    <div class="flex items-center gap-2 text-xs font-bold tracking-wider uppercase text-zinc-400 dark:text-zinc-500">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
      {t('sidebar.title')}
    </div>
    <nav class="toc-nav flex flex-col gap-2 text-sm text-zinc-500 dark:text-zinc-400">
      {INDICE.map((item) => (
        <a
          href={item.href}
          class:list={[
            'toc-link group flex items-center gap-3 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100',
            item.sub && 'pl-4 text-xs',
          ]}
        >
          <span class="toc-line h-px w-3 shrink-0 bg-zinc-200 dark:bg-zinc-800 transition-all group-hover:w-5 group-hover:bg-zinc-400"></span>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</aside>

<style>
  .toc-link.is-active {
    color: rgb(37 99 235); /* blue-600 */
    font-weight: 600;
  }
  :global(html.dark) .toc-link.is-active {
    color: rgb(96 165 250); /* blue-400 */
  }
  .toc-link.is-active .toc-line {
    width: 1.5rem;
    background-color: currentColor;
  }
</style>

<script>
  /**
   * Marca la sección que se está leyendo: la ÚLTIMA cuyo borde superior ya
   * pasó el umbral.
   *
   * No sirve un IntersectionObserver preguntando "cuál es visible": las
   * tarjetas de ejemplo viven DENTRO de `#uso-basico`, así que mientras se
   * recorre cualquiera de ellas la sección padre también está intersecando y,
   * por ir antes en el documento, se queda siempre con el activo. Con el
   * umbral la anidación se resuelve sola: el top de la tarjeta pasa después
   * que el de su sección, así que gana la más específica.
   */
  function setupTocSpy() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
    if (!links.length) return;

    const targets = links
      .map((link) => ({ link, el: document.querySelector(link.hash) }))
      .filter((t): t is { link: HTMLAnchorElement; el: Element } => !!t.el);
    if (!targets.length) return;

    const UMBRAL = 100; // px desde el tope, por debajo del header sticky

    let pendiente = false;
    const pintar = () => {
      pendiente = false;
      let activo = targets[0];
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top <= UMBRAL) activo = t;
      }
      for (const { link } of targets) link.classList.toggle('is-active', link === activo.link);
    };

    // ponytail: rAF de guardia — 11 getBoundingClientRect por frame es barato;
    // si el índice creciera, cachear los offsets y recalcular en resize.
    const alScrollear = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(pintar);
    };

    addEventListener('scroll', alScrollear, { passive: true });
    addEventListener('resize', alScrollear, { passive: true });
    pintar();
  }

  setupTocSpy();
  document.addEventListener('astro:after-swap', setupTocSpy);
</script>
