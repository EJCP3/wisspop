      <div class="p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 space-y-3 bg-zinc-50/50 dark:bg-zinc-900/30">
        <h4 class="font-bold text-sm text-zinc-900 dark:text-zinc-100">
