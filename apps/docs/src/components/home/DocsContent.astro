    >
      <li>
        <strong>Focus Trap:</strong> El foco del teclado queda confinado dentro del
        modal abierto.
      </li>
      <li>
        <strong>Tecla Escape:</strong> Cierra el panel automáticamente de forma nativa.
      </li>
      <li>
        <strong>Foco de Retorno:</strong> Al cerrar el panel, el foco vuelve automáticamente
        al elemento disparador.
      </li>
      <li>
        <strong>Reduced Motion:</strong> Si el sistema tiene activado <code
          class="font-mono text-xs px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800"
          >prefers-reduced-motion</code
        >, se salta la animación hacia la geometría final.
      </li>
    </ul>
  </section>
</div>

<script>
  import { createModal } from "wisspop/vanilla";

  function initFullAuthDemo() {
    const btnFull = document.getElementById("btn-auth-full-trigger");
    if (!btnFull || btnFull.dataset.wired) return;
    btnFull.dataset.wired = "true";

    const isEs = document.documentElement.lang === "es";
    let vista = "signup";
    let error = false;

    const campos = (v: string) => `
      <label>Email</label><input placeholder="hola@ejemplo.com" />
      <label>${isEs ? "Contraseña" : "Password"}</label><input type="password" placeholder="••••••••" />
      ${v === "signup" ? `<label>${isEs ? "Repetir contraseña" : "Confirm password"}</label><input type="password" placeholder="••••••••" />` : ""}`;

    const modal = createModal({
      swipeToClose: true,
      modalClass: "pill-panel",
      flyingTextClass: "flying",
      width: 540,
      radius: 40,
      originRadius: 999,
      duration: 0.45,
      ease: "power3.inOut",
    });

    const render = () => {
      const title =
        vista === "signup"
          ? isEs
            ? "Crear cuenta"
            : "Create account"
          : isEs
            ? "Iniciar sesión"
            : "Sign in";

      const switchText =
        vista === "signup"
          ? isEs
            ? "Ya tengo cuenta"
            : "I already have an account"
          : isEs
            ? "Quiero crear una cuenta"
            : "I want to create an account";

      const errorToggleText = error
        ? isEs
          ? "Ocultar error"
          : "Hide error"
        : isEs
          ? "Mostrar un error (resync)"
          : "Trigger error (resync)";

      const errorMsg = isEs
        ? "Las contraseñas no coinciden."
        : "Passwords do not match.";
      const continueBtn = isEs ? "Continuar" : "Continue";

      modal.content.innerHTML = `
        <div class="pill-body">
          <h2 data-wisspop-title>${title}</h2>
          ${campos(vista)}
          ${error ? `<p class="error">${errorMsg}</p>` : ""}
          <button data-close class="pill w-full mt-2">${continueBtn}</button>
          <button class="switch" data-error>${errorToggleText}</button>
          <button class="switch" data-vista>${switchText}</button>
        </div>`;
    };

    render();

    modal.content.addEventListener("click", (e: Event) => {
      const target = e.target as HTMLElement;
      if (target.closest("[data-close]")) modal.close();
      if (target.closest("[data-error]")) {
        error = !error;
        render();
        modal.resync();
      }
      if (target.closest("[data-vista]")) {
        modal.changeView(() => {
          vista = vista === "signup" ? "login" : "signup";
          error = false;
          render();
        });
      }
    });

    btnFull.addEventListener("click", () => {
      vista = "signup";
      error = false;
      render();
      modal.open(btnFull, isEs ? "Crear cuenta" : "Create account");
    });
  }

  initFullAuthDemo();
  document.addEventListener("astro:page-load", initFullAuthDemo);
  document.addEventListener("astro:after-swap", initFullAuthDemo);
</script>
