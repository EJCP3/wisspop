<script>
  import { createModal } from 'wisspop/vanilla';

  function initFullAuthDemo() {
    const btnFull = document.getElementById('btn-auth-full-trigger');
    if (!btnFull) return;

    let vista = 'signup';
    let error = false;

    const campos = (v: string) => `
      <label>Email</label><input placeholder="hola@ejemplo.com" />
      <label>Contraseña</label><input type="password" placeholder="••••••••" />
      ${v === 'signup' ? '<label>Repetir contraseña</label><input type="password" placeholder="••••••••" />' : ''}`;

    const modal = createModal({
      swipeToClose: true,
      modalClass: 'pill-panel',
      flyingTextClass: 'flying',
      width: 540,
      radius: 40,
      originRadius: 999,
      duration: 0.45,
      ease: 'power3.inOut',
    });

    const render = () => {
      modal.content.innerHTML = `
        <div class="pill-body">
          <h2 data-wisspop-title>${vista === 'signup' ? 'Crear cuenta' : 'Iniciar sesión'}</h2>
          ${campos(vista)}
          ${error ? '<p class="error">Las contraseñas no coinciden.</p>' : ''}
          <button data-close class="pill w-full mt-2">Continuar</button>
          <button class="switch" data-error>${error ? 'Ocultar error' : 'Mostrar un error (resync)'}</button>
          <button class="switch" data-vista>${vista === 'signup' ? 'Ya tengo cuenta' : 'Quiero crear una cuenta'}</button>
        </div>`;
    };

    render();

    modal.content.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-close]')) modal.close();
      if (target.closest('[data-error]')) {
        error = !error;
        render();
        modal.resync();
      }
      if (target.closest('[data-vista]')) {
        modal.changeView(() => {
          vista = vista === 'signup' ? 'login' : 'signup';
          error = false;
          render();
        });
      }
    });

    btnFull.addEventListener('click', () => {
      vista = 'signup';
      error = false;
      render();
      modal.open(btnFull, 'Crear cuenta');
    });
  }

  initFullAuthDemo();
  document.addEventListener('astro:after-swap', initFullAuthDemo);
</script>
