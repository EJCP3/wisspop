---
import type { Lang } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";
import CodeBlock from "../CodeBlock.astro";
import DocExampleCard from "../DocExampleCard.astro";
import WissPopMorph from "../wisspop/WissPopMorph.astro";
import WissPopPill from "../wisspop/WissPopPill.astro";
import WissPopFlip from "../wisspop/WissPopFlip.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const isEs = lang === "es";

const ANCLADOS = [
  {
    placement: "top",
    align: "start",
    etiqueta: isEs ? "top start" : "top start",
  },
  {
    placement: "top",
    align: "center",
    etiqueta: isEs ? "top center" : "top center",
  },
  { placement: "top", align: "end", etiqueta: isEs ? "top end" : "top end" },
  {
    placement: "left",
    align: "center",
    etiqueta: isEs ? "left center" : "left center",
  },
  {
    placement: "right",
    align: "center",
    etiqueta: isEs ? "right center" : "right center",
  },
  {
    placement: "bottom",
    align: "center",
    etiqueta: isEs ? "bottom center" : "bottom center",
  },
];
---

<div class="flex-1 min-w-0 space-y-16 pb-24">
  <!-- Introducción -->
  <section id="introduccion" class="scroll-mt-28 space-y-4 border-t-0 pt-0">
    <h2
      class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
    >
      {t("docs.intro_title")}
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed text-base">
      {t("docs.intro_p1")}
    </p>
    <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed text-base">
      {t("docs.intro_p2")}
    </p>
  </section>

  <!-- Instalación -->
  <section
    id="instalacion"
    class="scroll-mt-28 space-y-4 border-t border-zinc-200 dark:border-zinc-800 pt-8"
  >
    <h2
      class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
    >
      {t("docs.install_title")}
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
      {t("docs.install_p")}
    </p>
    <CodeBlock
      lang="bash"
      code="pnpm add wisspop # o npm install wisspop / yarn add wisspop"
    />
  </section>

  <!-- Ejemplos e Interacciones Completa -->
  <section
    id="uso-basico"
    class="scroll-mt-28 space-y-8 border-t border-zinc-200 dark:border-zinc-800 pt-8"
  >
    <div>
      <h2
        class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
      >
        {t("docs.uso_title")}
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
        {
          isEs
            ? "Catálogo completo de demostraciones de wisspop con sus métodos, configuraciones de origen, animaciones viajeras y gestos."
            : "Comprehensive catalog of wisspop live demos showing origin-anchored morphing, flying text, FLIP transitions, and gestures."
        }
      </p>
    </div>

    <!-- Ejemplo 1: Anclado a un botón -->
    <DocExampleCard
      title={isEs ? "1. Anclado a un botón" : "1. Anchored to a button"}
      description={isEs
        ? "El panel nace del botón y se posiciona en cualquiera de sus 6 combinaciones. El parámetro align controla la posición sobre el eje cruzado."
        : "The panel grows out of the button and docks at any of the 6 placement combinations."}
      code={`import { createModal } from 'wisspop/vanilla';

createModal({
  content: '<ul class="menu"><li>Opción 1</li><li>Opción 2</li></ul>',
  placement: 'top', // top | bottom | left | right
  align: 'center',  // start | center | end
  modalClass: 'panel',
}).open(boton);`}
      lang="javascript"
    >
      <div class="row">
        {
          ANCLADOS.map((item) => (
            <button
              data-wisspop-trigger={`anclado-${item.placement}-${item.align}`}
              class="demo-btn"
            >
              {item.etiqueta}
            </button>
          ))
        }
      </div>

      {
        ANCLADOS.map((item) => (
          <WissPopMorph
            id={`anclado-${item.placement}-${item.align}`}
            placement={item.placement}
            align={item.align}
            modalClass="panel"
            swipeToClose={true}
          >
            <ul class="menu">
              <li data-wisspop-close>
                {isEs ? "Más recientes" : "Most recent"}
              </li>
              <li data-wisspop-close>{isEs ? "Más antiguos" : "Oldest"}</li>
              <li data-wisspop-close>
                {isEs ? "Mayor monto" : "Highest amount"}
              </li>
            </ul>
          </WissPopMorph>
        ))
      }
    </DocExampleCard>

    <!-- Ejemplo 2: Desde un botón circular -->
    <DocExampleCard
      title={isEs ? "2. Desde un botón circular" : "2. From a circular button"}
      description={isEs
        ? "El radio del origen se lee dinámicamente del CSS. El glifo del botón '+' viaja hacia el elemento data-wisspop-title."
        : "The trigger's border radius is computed dynamically. The '+' icon flies into data-wisspop-title."}
      code={`createModal({
  placement: 'center',
  ease: 'power3.out',
  duration: 0.65,
  labelOffsetX: 20,
}).open(btnFab, '+');`}
      lang="javascript"
    >
      <div class="row">
        <button data-wisspop-trigger="modal-fab-demo" class="round">+</button>
      </div>

      <WissPopPill
        id="modal-fab-demo"
        placement="center"
        modalClass="panel"
        flyingTextClass="flying"
        swipeToClose={true}
      >
        <div class="panel-body" style="width: min(22rem, calc(100vw - 2rem));">
          <h3>
            <span data-wisspop-title>+</span>
            {isEs ? "Nuevo movimiento" : "New entry"}
          </h3>
          <label class="block text-xs font-semibold text-zinc-500 mt-2 mb-1"
            >{isEs ? "Concepto" : "Description"}</label
          >
          <input
            placeholder={isEs ? "Café" : "Coffee"}
            class="w-full px-3 py-2 text-sm rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800"
          />
          <label class="block text-xs font-semibold text-zinc-500 mt-2 mb-1"
            >{isEs ? "Monto" : "Amount"}</label
          >
          <input
            placeholder="2500"
            class="w-full px-3 py-2 text-sm rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800"
          />
          <button data-wisspop-close class="demo-btn w-full mt-3"
            >{isEs ? "Guardar" : "Save"}</button
          >
        </div>
      </WissPopPill>
    </DocExampleCard>

    <!-- Ejemplo 3: Crecer en el lugar -->
    <DocExampleCard
      title={isEs ? "3. Crecer en el lugar" : "3. Expand in place"}
      description={isEs
        ? "placement: 'origin' hace que el panel comparta el centro con el botón y se expanda directamente ahí sin viajar al centro de la ventana."
        : "placement: 'origin' centers the panel on the trigger button without moving towards viewport center."}
      code={`createModal({
  content: '...',
  placement: 'origin',
  modalClass: 'panel',
  closeButton: true,
}).open(btnInline);`}
      lang="javascript"
    >
      <div class="row">
        <button data-wisspop-trigger="modal-inline-demo" class="demo-btn"
          >{isEs ? "Renombrar" : "Rename"}</button
        >
      </div>

      <WissPopMorph
        id="modal-inline-demo"
        placement="origin"
        modalClass="panel"
        swipeToClose={true}
        closeButton={true}
      >
        <div class="panel-body" style="width: min(20rem, calc(100vw - 2rem));">
          <h3>{isEs ? "Renombrar" : "Rename"}</h3>
          <label class="block text-xs font-semibold text-zinc-500 mb-1"
            >{isEs ? "Nombre" : "Name"}</label
          >
          <input
            placeholder={isEs ? "Supermercado" : "Supermarket"}
            class="w-full px-3 py-2 text-sm rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 mb-3"
          />
          <button data-wisspop-close class="demo-btn w-full"
            >{isEs ? "Listo" : "Done"}</button
          >
        </div>
      </WissPopMorph>
    </DocExampleCard>

    <!-- Ejemplo 4: Drawer -->
    <DocExampleCard
      title={isEs
        ? "4. Drawer (Cajón lateral y vertical)"
        : "4. Drawers (Side and top/bottom)"}
      description={isEs
        ? "drawer-left, drawer-right, drawer-top y drawer-bottom adhieren el panel a los bordes completos de la ventana."
        : "drawer-left, drawer-right, drawer-top, and drawer-bottom dock the panel seamlessly to screen edges."}
      code={`createModal({
  content: '<ul class="menu">...</ul>',
  placement: 'drawer-left', // drawer-left | drawer-right | drawer-top | drawer-bottom
  modalClass: 'panel drawer drawer-left',
});`}
      lang="javascript"
    >
      <div class="row">
        {
          ["left", "right", "top", "bottom"].map((lado) => (
            <button
              data-wisspop-trigger={`drawer-${lado}-demo`}
              class="demo-btn"
            >
              drawer-{lado}
            </button>
          ))
        }
      </div>

      {
        ["left", "right", "top", "bottom"].map((lado) => (
          <WissPopMorph
            id={`drawer-${lado}-demo`}
            placement={`drawer-${lado}`}
            modalClass={`panel drawer drawer-${lado}`}
            swipeToClose={true}
          >
            <ul class="menu p-4">
              <li data-wisspop-close>{isEs ? "Inicio" : "Home"}</li>
              <li data-wisspop-close>
                {isEs ? "Movimientos" : "Transactions"}
              </li>
              <li data-wisspop-close>{isEs ? "Presupuestos" : "Budgets"}</li>
              <li data-wisspop-close>{isEs ? "Ajustes" : "Settings"}</li>
            </ul>
          </WissPopMorph>
        ))
      }
    </DocExampleCard>

    <!-- Ejemplo 5: Texto viajero (PillModal) -->
    <DocExampleCard
      title={isEs
        ? "5. Texto viajero (PillModal)"
        : "5. Flying text (PillModal)"}
      description={isEs
        ? "El texto del botón despegado viaja e interpola escala y posición hasta aterrizar en el título data-wisspop-title."
        : "The trigger label flies across the screen, smoothly interpolating size and position onto data-wisspop-title."}
      code={`// Una misma instancia puede abrirse en center u origin según la opción enviada al open
modal.open(boton, "Crear cuenta");
modal.open(boton, "Crear cuenta", { placement: "origin" });`}
      lang="javascript"
    >
      <div class="row">
        <button data-wisspop-trigger="pill-center-demo" class="pill"
          >{isEs ? "Crear cuenta (Center)" : "Create account (Center)"}</button
        >
        <button data-wisspop-trigger="pill-origin-demo" class="pill"
          >{isEs ? "Crear cuenta (Origin)" : "Create account (Origin)"}</button
        >
      </div>

      <WissPopPill
        id="pill-center-demo"
        placement="center"
        modalClass="pill-panel"
        flyingTextClass="flying"
        swipeToClose={true}
      >
        <div class="pill-body" style="width: min(22rem, calc(100vw - 2rem));">
          <h2 data-wisspop-title>{isEs ? "Crear cuenta" : "Create account"}</h2>
          <label>Email</label>
          <input placeholder="hola@ejemplo.com" />
          <label>{isEs ? "Contraseña" : "Password"}</label>
          <input type="password" placeholder="••••••••" />
          <button data-wisspop-close class="pill w-full mt-2"
            >{isEs ? "Continuar" : "Continue"}</button
          >
        </div>
      </WissPopPill>

      <WissPopPill
        id="pill-origin-demo"
        placement="origin"
        modalClass="pill-panel"
        flyingTextClass="flying"
        swipeToClose={true}
      >
        <div class="pill-body" style="width: min(22rem, calc(100vw - 2rem));">
          <h2 data-wisspop-title>{isEs ? "Crear cuenta" : "Create account"}</h2>
          <label>Email</label>
          <input placeholder="hola@ejemplo.com" />
          <label>{isEs ? "Contraseña" : "Password"}</label>
          <input type="password" placeholder="••••••••" />
          <button data-wisspop-close class="pill w-full mt-2"
            >{isEs ? "Continuar" : "Continue"}</button
          >
        </div>
      </WissPopPill>
    </DocExampleCard>

    <!-- Ejemplo 6: Formatos del elemento viajero -->
    <DocExampleCard
      title={isEs
        ? "6. Formatos del elemento viajero"
        : "6. Flying element formats"}
      description={isEs
        ? "Se escala automáticamente texto con font-size o imágenes y nodos con width/height. Admite solo texto, texto con icono, solo icono o imágenes completas."
        : "Scales font-size for text, and width/height for icons and images."}
      code={`// Texto suelto
modal.open(boton, "Solo texto");

// Nodo interno (icono o imagen)
modal.open(boton, boton.querySelector("svg"));
modal.open(boton, boton.querySelector("img"));`}
      lang="javascript"
    >
      <div class="row">
        <button data-wisspop-trigger="fmt-texto-demo" class="pill"
          >{isEs ? "Solo texto" : "Plain text"}</button
        >
        <button data-wisspop-trigger="fmt-mixto-demo" class="pill">
          <span class="con-icono">
            <svg
              class="ico"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"
              ></path>
            </svg>
            <span>{isEs ? "Me gusta" : "Like"}</span>
          </span>
        </button>
        <button data-wisspop-trigger="fmt-icono-demo" class="round">
          <svg
            class="ico"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245"
            ></path>
          </svg>
        </button>
        <button data-wisspop-trigger="fmt-imagen-demo" class="avatar-btn">
          <img src="/gato.jpg" alt="" />
        </button>
      </div>

      <WissPopPill
        id="fmt-texto-demo"
        placement="center"
        modalClass="panel"
        flyingTextClass="flying"
        swipeToClose={true}
      >
        <div class="panel-body" style="width: min(21rem, calc(100vw - 2rem));">
          <h3>
            <span data-wisspop-title>{isEs ? "Solo texto" : "Plain text"}</span>
          </h3>
          <p class="nota">
            {
              isEs
                ? "No hay nodo que medir, el punto de partida sale del texto del botón."
                : "No DOM node to measure, the origin point is calculated from button text."
            }
          </p>
          <button data-wisspop-close class="demo-btn"
            >{isEs ? "Cerrar" : "Close"}</button
          >
        </div>
      </WissPopPill>

      <WissPopPill
        id="fmt-mixto-demo"
        placement="center"
        modalClass="panel"
        flyingTextClass="flying"
        swipeToClose={true}
      >
        <div class="panel-body" style="width: min(21rem, calc(100vw - 2rem));">
          <h3>
            <span data-wisspop-title class="con-icono">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"
                ></path></svg
              >
              <span>{isEs ? "Me gusta" : "Like"}</span>
            </span>
          </h3>
          <p class="nota">
            {
              isEs
                ? "El icono medido en em escala exactamente junto con el texto."
                : "The icon sized in em scales proportionally with the text."
            }
          </p>
          <button data-wisspop-close class="demo-btn"
            >{isEs ? "Cerrar" : "Close"}</button
          >
        </div>
      </WissPopPill>

      <WissPopPill
        id="fmt-icono-demo"
        placement="center"
        modalClass="panel"
        flyingTextClass="flying"
        swipeToClose={true}
      >
        <div class="panel-body" style="width: min(21rem, calc(100vw - 2rem));">
          <h3>
            <span data-wisspop-title class="ico-destino">
              <svg
                class="ico"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245"
                ></path></svg
              >
            </span>
          </h3>
          <p class="nota">
            {
              isEs
                ? "Sin texto que escalar, el core pasa a modo box animando width/height."
                : "Without text to scale, core switches to box mode animating width/height."
            }
          </p>
          <button data-wisspop-close class="demo-btn"
            >{isEs ? "Cerrar" : "Close"}</button
          >
        </div>
      </WissPopPill>

      <WissPopPill
        id="fmt-imagen-demo"
        placement="center"
        modalClass="panel"
        flyingTextClass="flying"
        swipeToClose={true}
      >
        <div class="panel-body" style="width: min(21rem, calc(100vw - 2rem));">
          <span data-wisspop-title class="foto-destino"
            ><img src="/gato.jpg" alt="" /></span
          >
          <h3 class="font-bold text-base text-zinc-900 dark:text-zinc-100 mt-3">
            {isEs ? "No hace nada, HD" : "Cat Portrait, HD"}
          </h3>
          <p class="nota">
            {
              isEs
                ? "Despega desde la miniatura y aterriza en el destino manteniendo proporción."
                : "Takes off from thumbnail and lands into destination maintaining aspect ratio."
            }
          </p>
          <button data-wisspop-close class="demo-btn"
            >{isEs ? "Cerrar" : "Close"}</button
          >
        </div>
      </WissPopPill>
    </DocExampleCard>

    <!-- Ejemplo 7: Cerrar con el gesto -->
    <DocExampleCard
      title={isEs
        ? "7. Cerrar con el gesto (Swipe to Close)"
        : "7. Gesture dismissal (Swipe to Close)"}
      description={isEs
        ? "swipeToClose: true permite descartar el panel arrastrándolo hacia cualquier dirección con el mouse o dedo."
        : "swipeToClose: true allows dismissing the panel by dragging it in any direction."}
      code={`createModal({
  content: '...',
  modalClass: 'panel',
  swipeToClose: true,
  swipeThreshold: 90,
});`}
      lang="javascript"
    >
      <div class="row">
        <button data-wisspop-trigger="swipe-demo-modal" class="demo-btn"
          >{isEs ? "Arrastrame para cerrar" : "Drag me to close"}</button
        >
      </div>

      <WissPopMorph
        id="swipe-demo-modal"
        placement="center"
        modalClass="panel"
        swipeToClose={true}
      >
        <div class="panel-body" style="width: min(20rem, calc(100vw - 2rem));">
          <h3>{isEs ? "Arrastrame" : "Drag me"}</h3>
          <p class="nota">
            {
              isEs
                ? "Hacia cualquier lado con el mouse o dedo. Si soltás antes del umbral, vuelve solo."
                : "In any direction with mouse or finger. If released before threshold, snaps back."
            }
          </p>
          <button data-wisspop-close class="demo-btn"
            >{isEs ? "O cerrame así" : "Or close me like this"}</button
          >
        </div>
      </WissPopMorph>
    </DocExampleCard>

    <!-- Ejemplo 8: FlipModal — Elementos compartidos -->
    <DocExampleCard
      title={isEs
        ? "8. FlipModal — Elementos compartidos"
        : "8. FlipModal — Shared elements"}
      description={isEs
        ? "Elementos individuales con data-flip-id viajan del origen al modal conservando su identidad visual con GSAP Flip."
        : "Individual elements with data-flip-id travel from trigger to modal with GSAP Flip."}
      code={`createFlipModal({
  trigger: document.getElementById('card-trigger'),
  flipId: 'demo',
  modalClass: 'panel',
  content: '...'
});`}
      lang="javascript"
    >
      <div
        id="card-flip-trigger"
        data-wisspop-trigger="flip-card-demo"
        data-flip-id="demo-card"
        class="card-demo cursor-pointer p-4 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl w-64 shadow-sm hover:shadow-md transition-shadow"
      >
        <img
          data-flip-id="demo-img"
          src="/gato.jpg"
          class="w-full h-28 object-cover rounded-xl"
          alt="Gato Viajero"
        />
        <h3
          data-flip-id="demo-title"
          class="mt-2 text-base font-bold text-zinc-900 dark:text-zinc-100"
        >
          {isEs ? "Gato Viajero" : "Travelling Cat"}
        </h3>
        <p class="trigger-fade-item-demo text-xs text-zinc-400 mt-1">
          {isEs ? "Clic para expandir detalle" : "Click to expand detail"}
        </p>
      </div>

      <WissPopFlip
        id="flip-card-demo"
        flipId="demo"
        closeButton={true}
        swipeToClose={true}
      >
        <div
          data-flip-id="demo-card"
          class="panel"
          style="padding: 1.5rem; width: 24rem; max-width: 90vw;"
        >
          <img
            data-flip-id="demo-img"
            src="/gato.jpg"
            style="width: 100%; height: 220px; object-fit: cover; border-radius: 0.75rem;"
            alt="Gato Viajero"
          />
          <h3
            data-flip-id="demo-title"
            style="margin-top: 1rem; font-size: 1.5rem;"
            class="text-zinc-900 dark:text-zinc-100 font-bold"
          >
            {isEs ? "Gato Viajero" : "Travelling Cat"}
          </h3>
          <p
            class="modal-fade-item-demo"
            style="margin-top: 0.5rem; color: var(--muted); line-height: 1.4; font-size: 0.9rem;"
          >
            {
              isEs
                ? "Esta foto y título viajaron directamente desde la tarjeta usando GSAP Flip conservando dimensiones reales."
                : "This photo and heading travelled directly from the card using GSAP Flip."
            }
          </p>
        </div>
      </WissPopFlip>
    </DocExampleCard>

    <!-- Ejemplo 9: DropdownPanel — Despliegue elástico -->
    <DocExampleCard
      title={isEs
        ? "9. DropdownPanel — Despliegue elástico"
        : "9. DropdownPanel — Elastic menu"}
      description={isEs
        ? "Despliegue elástico ligero con enterDropdownAnimation y leaveDropdownAnimation."
        : "Elastic dropdown with enterDropdownAnimation and leaveDropdownAnimation."}
