>
  <!-- Contenido interno limpio con ancho responsivo -->
  <div class="p-5" style="width: min(24rem, calc(100vw - 2rem));">
    <h3 class="font-bold text-base">Contenido</h3>
  </div>
</WissPopMorph>`}
