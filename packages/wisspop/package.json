{
  "name": "wisspop",
  "version": "0.2.0",
  "type": "module",
  "description": "Modales y dropdowns con animaciones ancladas al origen: el panel nace del elemento que lo abrió",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EJCP3/wisspop.git"
  },
  "bugs": {
    "url": "https://github.com/EJCP3/wisspop/issues"
  },
  "homepage": "https://github.com/EJCP3/wisspop#readme",
  "keywords": [
    "modal",
    "dropdown",
    "animation",
    "gsap",
    "vue",
    "flip",
    "transition"
  ],
  "main": "./dist/core.cjs",
  "module": "./dist/core.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./styles.css": "./dist/wisspop.css"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "vite build",
    "test": "node --test \"src/**/*.test.js\""
  },
  "peerDependencies": {
    "gsap": ">=3.12",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "gsap": "^3.13.0",
    "jsdom": "^30.0.1",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.22"
  }
}
