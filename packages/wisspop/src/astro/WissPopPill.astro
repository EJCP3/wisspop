---
/**
 * WissPopPill: Modal donde la caja se expande y el label/icono del botón vuela hacia `[data-wisspop-title]`.
 * Ideal para formularios principales, auth, calculadoras y diálogos con título transformable.
 *
 * NOTA DE BUENAS PRÁCTICAS:
 * - Requiere un elemento con `data-wisspop-title` dentro del modal donde aterrizará el texto del botón.
 * - Puedes usar `data-wisspop-label` en el botón para especificar un texto/nodo específico de vuelo.
 * - Pasa los estilos del contenedor (bg, border, rounded, shadow) en `modalClass`.
 */
interface Props {
  /** ID único del modal. Disparadores con `data-wisspop-trigger="id"` lo abrirán. */
  id: string;
  /** Selector personalizado de los disparadores. Por defecto: `[data-wisspop-trigger="${id}"]`. */
  trigger?: string;
  placement?: string;
  width?: number;
  radius?: number;
  originRadius?: number;
  fullscreenOnMobile?: boolean;
  duration?: number;
  ease?: string;
  closeDuration?: number;
  closeEase?: string;
  contentBlur?: boolean;
  swipeToClose?: boolean;
  closeButton?: boolean;
  lockScroll?: boolean;
  closeOnEscape?: boolean;
  trapFocus?: boolean;
  restoreFocus?: boolean;
  modalClass?: string;
  overlayClass?: string;
  /** Clases CSS para el elemento de texto/icono viajero. */
  flyingTextClass?: string;
  [key: string]: any;
}

const {
  id,
  trigger = `[data-wisspop-trigger="${id}"]`,
  placement = 'center',
  width = 540,
  radius = 40,
  originRadius = 999,
  fullscreenOnMobile = true,
  duration = 0.45,
  ease = 'power3.inOut',
  closeDuration = 0.6,
  closeEase = 'power3.inOut',
  contentBlur = false,
  flyingTextClass = '',
  ...opciones
} = Astro.props;

const opts = JSON.stringify({
  trigger,
  placement,
  width,
  radius,
  originRadius,
  fullscreenOnMobile,
  duration,
  ease,
  closeDuration,
  closeEase,
  contentBlur,
  flyingTextClass,
  ...opciones,
});
---

<template data-wisspop="pill" data-id={id} data-opts={opts}>
  <slot />
</template>

<script>
  import { initWissPop } from './client.js';
  initWissPop('pill');
</script>
