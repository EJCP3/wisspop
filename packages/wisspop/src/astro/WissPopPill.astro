---
/**
 * Igual que WissPopMorph, con el preset del pill: el label del botón viaja
 * hasta el `[data-wisspop-title]` del panel. Los defaults son los mismos que
 * los del wrapper de React (ver WissPopPill.jsx); cualquiera se puede pisar.
 */
interface Props {
  id: string;
  trigger?: string;
  placement?: string;
  width?: number;
  radius?: number;
  duration?: number;
  ease?: string;
  swipeToClose?: boolean;
  closeButton?: boolean;
  modalClass?: string;
  overlayClass?: string;
  flyingTextClass?: string;
  [key: string]: any;
}

const {
  id,
  trigger = `[data-wisspop-trigger="${id}"]`,
  placement = 'center',
  width = 540,
  radius = 40,
  originRadius = 999,
  fullscreenOnMobile = true,
  duration = 0.45,
  ease = 'power3.inOut',
  closeDuration = 0.6,
  closeEase = 'power3.inOut',
  contentBlur = false,
  flyingTextClass = '',
  ...opciones
} = Astro.props;

const opts = JSON.stringify({
  trigger,
  placement,
  width,
  radius,
  originRadius,
  fullscreenOnMobile,
  duration,
  ease,
  closeDuration,
  closeEase,
  contentBlur,
  flyingTextClass,
  ...opciones,
});
---

<template data-wisspop="pill" data-id={id} data-opts={opts}>
  <slot />
</template>

<script>
  import { initWissPop } from './client.js';
  initWissPop('pill');
</script>
