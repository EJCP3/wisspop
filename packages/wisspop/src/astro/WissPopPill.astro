---
/**
 * WissPopPill: Variante optimizada con elemento viajero que traslada y escala
 * texto, iconos o imágenes entre el disparador y el modal.
 *
 * NOTA DE BUENAS PRÁCTICAS:
 * - Requiere un elemento con `data-wisspop-title` en el contenido del modal.
 * - Pasa `flyingTextClass="flying"` para la clase de vuelo animado por GSAP.
 */
interface Props {
  /** ID único del modal. Los disparadores con `data-wisspop-trigger="id"` lo abrirán automáticamente. */
  id: string;
  /** Selector personalizado de los disparadores. Por defecto: `[data-wisspop-trigger="${id}"]`. */
  trigger?: string;
  /** Posición: 'origin' | 'center' | 'top' | 'bottom' | 'left' | 'right' | 'drawer-left' | 'drawer-right' | 'drawer-top' | 'drawer-bottom' | 'fullscreen' */
  placement?: string;
  align?: string;
  width?: number;
  radius?: number;
  originRadius?: number;
  fullscreenOnMobile?: boolean;
  duration?: number;
  ease?: string;
  closeDuration?: number;
  closeEase?: string;
  contentBlur?: boolean;
  flyingTextClass?: string;
  swipeToClose?: boolean;
  closeButton?: boolean;
  lockScroll?: boolean;
  closeOnEscape?: boolean;
  trapFocus?: boolean;
  restoreFocus?: boolean;
  modalClass?: string;
  overlayClass?: string;
  [key: string]: any;
}

const {
  id,
  trigger = `[data-wisspop-trigger="${id}"]`,
  flyingTextClass = 'flying',
  ...opciones
} = Astro.props;

const opts = JSON.stringify({
  trigger,
  flyingTextClass,
  ...opciones,
});
---

<template data-wisspop="pill" data-id={id} data-opts={opts}>
  <slot />
</template>

<script>
  import { initWissPop } from './client.js';
  initWissPop('pill');
</script>
