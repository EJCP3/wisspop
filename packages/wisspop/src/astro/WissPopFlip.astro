---
/**
 * WissPopFlip: Transición de elementos compartidos (GSAP Flip) entre una tarjeta o elemento origen y el modal.
 * Ideal para galerías de productos, cards interactivas y vistas de detalle expandidas.
 *
 * NOTA DE BUENAS PRÁCTICAS:
 * - Requiere atributos `data-flip-id="id-unico"` coincidentes en los elementos del trigger y del modal.
 * - Pasa los estilos del contenedor en `modalClass`.
 */
interface Props {
  /** ID único del modal. */
  id: string;
  /** Prefijo de los `data-flip-id` que viajan. Obligatorio. */
  flipId: string;
  trigger?: string;
  duration?: number;
  ease?: string;
  closeDuration?: number;
  closeEase?: string;
  swipeToClose?: boolean;
  closeButton?: boolean;
  lockScroll?: boolean;
  closeOnEscape?: boolean;
  trapFocus?: boolean;
  restoreFocus?: boolean;
  modalClass?: string;
  overlayClass?: string;
  [key: string]: any;
}

const { id, flipId, trigger = `[data-wisspop-trigger="${id}"]`, ...opciones } = Astro.props;

if (!flipId) throw new Error(`[WissPopFlip] falta flipId en "${id}"`);
---

<template data-wisspop="flip" data-id={id} data-opts={JSON.stringify({ trigger, flipId, ...opciones })}>
  <slot />
</template>

<script>
  import { initWissPop } from './client.js';
  initWissPop('flip');
</script>
