---
interface Props {
  id: string;
  trigger?: string;
  swipeToClose?: boolean;
  closeOnEscape?: boolean;
  restoreFocus?: boolean;
  lockScroll?: boolean;
  modalClass?: string;
}

const {
  id,
  trigger = `[data-wisspop-trigger="${id}"]`,
  swipeToClose = false,
  closeOnEscape = true,
  restoreFocus = true,
  lockScroll = true,
  modalClass = '',
} = Astro.props;
---

<dialog
  id={id}
  class:list={['wisspop-dialog', modalClass]}
  data-wisspop-astro-modal="flip"
  data-trigger={trigger}
  data-swipe-to-close={swipeToClose ? 'true' : 'false'}
  data-close-on-escape={closeOnEscape ? 'true' : 'false'}
  data-restore-focus={restoreFocus ? 'true' : 'false'}
  data-lock-scroll={lockScroll ? 'true' : 'false'}
  style="display: none;"
>
  <slot />
</dialog>

<script>
  import { createFlipModal } from 'wisspop/vanilla';

  function initFlipModals() {
    document.querySelectorAll<HTMLElement>('dialog[data-wisspop-astro-modal="flip"]').forEach((dialogEl) => {
      if ((dialogEl as any)._wisspop) return;

      const triggerSel = dialogEl.getAttribute('data-trigger');
      const swipeToClose = dialogEl.getAttribute('data-swipe-to-close') === 'true';
      const closeOnEscape = dialogEl.getAttribute('data-close-on-escape') !== 'false';
      const restoreFocus = dialogEl.getAttribute('data-restore-focus') !== 'false';
      const lockScroll = dialogEl.getAttribute('data-lock-scroll') !== 'false';

      const flip = createFlipModal({
        target: dialogEl,
        swipeToClose,
        closeOnEscape,
        restoreFocus,
        lockScroll,
      });

      (dialogEl as any)._wisspop = flip;

      if (triggerSel) {
        document.querySelectorAll<HTMLElement>(triggerSel).forEach((btn) => {
          btn.addEventListener('click', () => flip.open(btn));
        });
      }

      dialogEl.querySelectorAll<HTMLElement>('[data-wisspop-close]').forEach((btn) => {
        btn.addEventListener('click', () => flip.close());
      });
    });
  }

  initFlipModals();
  document.addEventListener('astro:page-load', initFlipModals);
  document.addEventListener('astro:after-swap', initFlipModals);
</script>
