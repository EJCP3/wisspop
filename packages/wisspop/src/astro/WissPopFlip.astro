---
/**
 * Transición de elementos compartidos. Los `[data-flip-id]` del trigger y los
 * del panel se emparejan por nombre, así que `flipId` es el prefijo común:
 * con `flipId="demo"` viajan `demo-card`, `demo-img`, `demo-title`…
 */
interface Props {
  id: string;
  /** Prefijo de los `data-flip-id` que viajan. Obligatorio. */
  flipId: string;
  trigger?: string;
  duration?: number;
  ease?: string;
  swipeToClose?: boolean;
  closeButton?: boolean;
  modalClass?: string;
  overlayClass?: string;
  [key: string]: any;
}

const { id, flipId, trigger = `[data-wisspop-trigger="${id}"]`, ...opciones } = Astro.props;

if (!flipId) throw new Error(`[WissPopFlip] falta flipId en "${id}"`);
---

<template data-wisspop="flip" data-id={id} data-opts={JSON.stringify({ trigger, flipId, ...opciones })}>
  <slot />
</template>

<script>
  import { initWissPop } from './client.js';
  initWissPop('flip');
</script>
