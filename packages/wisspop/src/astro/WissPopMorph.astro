---
/**
 * Panel que nace del botón que lo abrió. Todo lo que no sea `id`/`trigger` se
 * reenvía tal cual a `createModal` — mismas opciones que el adaptador vanilla.
 */
interface Props {
  id: string;
  /** Selector de los disparadores. Por defecto, los que apuntan a este `id`. */
  trigger?: string;
  placement?: string;
  align?: string;
  gap?: number;
  margin?: number;
  duration?: number;
  ease?: string;
  swipeToClose?: boolean;
  closeButton?: boolean;
  lockScroll?: boolean;
  modalClass?: string;
  overlayClass?: string;
  /** Si está, se crea el texto viajero con esta clase (ver `data-wisspop-title`). */
  flyingTextClass?: string;
  [key: string]: any;
}

const { id, trigger = `[data-wisspop-trigger="${id}"]`, ...opciones } = Astro.props;
---

<template data-wisspop="morph" data-id={id} data-opts={JSON.stringify({ trigger, ...opciones })}>
  <slot />
</template>

<script>
  import { initWissPop } from './client.js';
  initWissPop('morph');
</script>
